# Index database and its document table
DATABASE_SQL_LOGIN=
DATABASE_SQL_PASSWORD=
DATABASE_SQL_HOST=localhost:3306
DATABASE_DATABASE=database
DATABASE_TABLE=parsing_documents

# Document tables (document_{id})
DOCUMENTS_SQL_LOGIN=
DOCUMENTS_SQL_PASSWORD=
DOCUMENTS_SQL_HOST=localhost:3306
DOCUMENTS_DATABASE=database_documents

# Output and schedule
OUTPUT_DIR=D:\autodump\out
SCHEDULE_TIMES=02:00
RUN_ON_START=false
START_ID=0
BATCH_SIZE=100
MERGE_THRESHOLD=150
STALL_HOURS=24

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_RETRY_ATTEMPTS=3

# Log
LOG_FILE=autodump.log
LOG_FILE_MB=100
LOG_TOTAL_MB=1024

# Performance
WORKERS=2
INSERT_BATCH_ROWS=1000
INSERT_BATCH_BYTES=4194304
WRITE_BUFFER_MB=4
DB_RETRY_ATTEMPTS=5
DB_RETRY_BASE_SEC=5
